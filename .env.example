# Copy to .env (never commit .env). docker compose and the API both read it.

# --- Claude (RAG assistant). Without it the chat runs in demo mode.
ANTHROPIC_API_KEY=

# --- Loops.so (lead + course-interest emails). Without it events are skipped.
LOOPS_API_KEY=

# --- Security: long random strings in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Shared secret between the Next.js server and the API (optional locally, required in production)
INTERNAL_API_KEY=

# --- Object storage (RustFS locally; S3 / Cloudflare R2 in production)
S3_BUCKET=codex-media
S3_ACCESS_KEY=codex
S3_SECRET_KEY=codex-secret

# --- Client portal
# Dedicated identity database (created on first boot by app.clientes.bootstrap using DATABASE_URL's superuser).
CLIENTES_DATABASE_URL=postgresql+asyncpg://clientes_app:clientes-dev@db:5432/codex_clientes
PORTAL_URL=http://localhost:3000
# Cloudflare Turnstile. These are Cloudflare's official always-pass TEST keys; use real keys in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# HMAC secret shared with VS Master Control for /v1/sync (empty disables the sync API).
SYNC_SHARED_SECRET=
# Loops transactional template ids (invitation, reset, password changed). Without them emails are skipped.
LOOPS_TX_INVITACION=
LOOPS_TX_RESTABLECER=
LOOPS_TX_CONTRASENA_CAMBIADA=

# --- Web (Next.js server)
# API_URL=http://localhost:8010          # when running `npm run dev` outside docker
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Local development seed admin (created with `python -m app.cli create-admin`).
# Local only — never reuse these values in production. Also read by the Playwright e2e suite.
E2E_ADMIN_EMAIL=admin@codexai.com
E2E_ADMIN_PASSWORD=codex-admin-2026
