# Production values for infra/docker-compose.prod.yml. Copy to infra/.env.prod (never commit it).
# Generate secrets with:  openssl rand -hex 32

SITE_URL=https://codexai.com
API_DOMAIN=api.codexai.com
MEDIA_DOMAIN=media.codexai.com

POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=

ANTHROPIC_API_KEY=
LOOPS_API_KEY=

# Course payments: leave empty (sales off) until the client's gateway keys arrive. Never "mock" here.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
